{
  "name": "@tiden/jest-reporter",
  "version": "0.1.1",
  "description": "Tiden Jest Reporter",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./jest": "./dist/jest.js",
    "./reporter": "./dist/reporter.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "jest": [
        "./dist/jest.d.ts"
      ],
      "reporter": [
        "./dist/reporter.d.ts"
      ]
    }
  },
  "homepage": "https://github.com/qase-tms/tiden-javascript",
  "bugs": {
    "url": "https://github.com/qase-tms/tiden-javascript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qase-tms/tiden-javascript.git",
    "directory": "jest"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "jest",
    "tiden",
    "reporter",
    "testing"
  ],
  "author": "Tiden Team <support@tiden.ai>",
  "license": "Apache-2.0",
  "dependencies": {
    "@tiden/reporter-commons": "^0.1.1",
    "uuid": "11.1.1"
  },
  "peerDependencies": {
    "jest": ">=28.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@jest/reporters": "^29.7.0",
    "@jest/test-result": "^29.7.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5"
  }
}
