{
  "name": "@tiden/reporter-commons",
  "version": "0.1.0",
  "description": "Tiden JS Reporters",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./profilers": {
      "types": "./dist/profilers/index.d.ts",
      "default": "./dist/profilers/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "default": "./dist/internal/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "profilers": [
        "./dist/profilers/index.d.ts"
      ],
      "internal": [
        "./dist/internal/index.d.ts"
      ]
    }
  },
  "homepage": "https://github.com/qase-tms/tiden-javascript",
  "bugs": {
    "url": "https://github.com/qase-tms/tiden-javascript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qase-tms/tiden-javascript.git",
    "directory": "commons"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "author": "Tiden Team <support@tiden.ai>",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.18.0",
    "async-mutex": "~0.5.0",
    "axios": "^1.16.0",
    "chalk": "^4.1.2",
    "env-schema": "^5.2.1",
    "form-data": "^4.0.6",
    "lodash.get": "^4.4.2",
    "lodash.merge": "^4.6.2",
    "lodash.mergewith": "^4.6.2",
    "mime-types": "^2.1.35",
    "strip-ansi": "^6.0.1",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/lodash.mergewith": "^4.6.9",
    "@types/mime-types": "^2.1.4",
    "@types/minimatch": "^6.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5"
  }
}
